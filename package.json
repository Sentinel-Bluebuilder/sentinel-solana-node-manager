{
  "name": "sentinel-node-manager-solana",
  "version": "0.3.0",
  "private": true,
  "description": "Sentinel Node Manager (Solana devnet) — desktop app for deploying and managing Sentinel dVPN nodes on the Solana program",
  "main": "out/main/index.cjs",
  "author": "Sentinel Node Manager",
  "homepage": "https://github.com/Sentinel-Bluebuilder/sentinel-solana-node-manager",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "predev": "electron-builder install-app-deps || true",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/cli-e2e.mjs",
    "test:universal": "node tests/e2e/universal.mjs",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3",
    "package:dir": "electron-vite build && electron-builder --dir",
    "package:mac": "electron-vite build && electron-builder --mac",
    "package:win": "electron-vite build && electron-builder --win",
    "package:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@fontsource-variable/outfit": "5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@scure/bip39": "1.6.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^12.0.0",
    "dockerode": "^4.0.10",
    "material-symbols": "^0.44.2",
    "qrcode": "^1.5.4",
    "recharts": "^2.15.4",
    "ssh2": "^1.15.0",
    "winston": "^3.19.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dockerode": "^3.3.47",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ssh2": "^1.15.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^39.8.5",
    "electron-builder": "^26.0.12",
    "electron-vite": "^2.3.0",
    "happy-dom": "^20.9.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.10",
    "npm": ">=10"
  }
}
